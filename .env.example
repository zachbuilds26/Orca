PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ORCA_BOT_URL=
# Public HTTPS URL for the Telegram Mini App. Localhost works only for browser development.
ORCA_PUBLIC_APP_ORIGIN=https://your-orca-domain.example
ORCA_MINI_APP_URL=https://your-orca-domain.example/wallet.html
# Create a free project and allowlist the public app origin at cloud.reown.com.
REOWN_PROJECT_ID=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORCA_SESSION_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
ORCA_WEB_SESSION_TTL_SECONDS=1800
ORCA_WALLET_NONCE_TTL_SECONDS=300
MAX_OPEN_INTENTS_PER_USER=3
# Optional Groq-powered chat router for idle Telegram messages.
GROQ_API_KEY=
